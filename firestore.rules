rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * 公開サイトは /api/properties 経由で読む（Admin SDK）。
     * admin.html は Firebase Auth ログイン後に読み書き。
     * 本番では custom claim admin や許可 UID リストに絞ることを推奨（docs/FIREBASE_SETUP.md）。
     */
    match /properties/{propertyId} {
      allow read, write: if request.auth != null;
    }
  }
}
